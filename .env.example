# Local development configuration. Copy to .env; never commit real secrets.
APP_ENV=local
HOST=127.0.0.1
PORT=8029

# Local Vite development ports. PORT is the portable backend listener;
# BACKEND_PORT remains the Vite proxy/local-script compatibility value.
BACKEND_PORT=8029
FRONTEND_PORT=5191

# Local/test database. Leave DATABASE_URL empty until Prompt 4 adds
# server-database and Alembic support.
DATABASE_URL=
APP_DATABASE_PATH=./data/itss_dashboard.db

# Local relative storage defaults. Staging and production require explicit,
# absolute persistent paths outside the immutable application release.
APP_DOCUMENT_PATH=./data/documents
APP_IMPORT_PATH=./data/imports
APP_EXPORT_PATH=./data/exports
APP_VECTOR_PATH=./data/vector_store
APP_TEMPLATE_PATH=./data/templates
APP_STORAGE_DIR=storage

# Local-only identity fallback and development signing secret.
# Staging/production must disable anonymous access and inject a unique secret.
ALLOW_ANONYMOUS_LOCAL=true
APP_STORAGE_SECRET=local-development-secret
FRONTEND_DIST_DIR=
LOG_LEVEL=INFO

APP_DISPLAY_NAME=IEEE ITSS Conference Status Dashboard
APP_DESCRIPTION=Local-first dashboard for IEEE ITSS conference portfolio oversight.
MAX_UPLOAD_FILES=20
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_CONCURRENT_RUNS=2
WORKFLOW_DELAY_SECONDS=0
WORKFLOW_OUTPUT_TAG=ITSS dashboard import processed

# Staging/production shape (examples only; keep commented and inject secrets).
# APP_ENV=staging
# HOST=0.0.0.0
# PORT=<provider-assigned-port>
# DATABASE_URL=<secret-managed-sqlalchemy-url>
# APP_DOCUMENT_PATH=/absolute/persistent/path/documents
# APP_IMPORT_PATH=/absolute/persistent/path/imports
# APP_EXPORT_PATH=/absolute/persistent/path/exports
# APP_VECTOR_PATH=/absolute/persistent/path/vector_store
# APP_TEMPLATE_PATH=/absolute/persistent/path/templates
# APP_STORAGE_DIR=/absolute/persistent/path/runs
# ALLOW_ANONYMOUS_LOCAL=false
# APP_STORAGE_SECRET=<secret-manager-value>

# Optional platform LLM gateway. All values are feature-conditional.
PLATFORM_LLM_BASE_URL=
PLATFORM_LLM_API_KEY=
PLATFORM_ALLOWED_MODEL_ALIASES=default-reasoning,default-fast

# Optional direct Azure OpenAI compatibility settings.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_CA_BUNDLE=
AZURE_OPENAI_PROXY=
AZURE_OPENAI_TIMEOUT_SECONDS=20
AZURE_OPENAI_TEMPERATURE=0.2
AZURE_OPENAI_MAX_TOKENS=2000
AZURE_OPENAI_USE_WINDOWS_CERT_STORE=1

# Optional TEI-compatible embedding service.
TEI_EMBEDDING_BASE_URL=
TEI_EMBEDDING_MODEL=qwen3
TEI_EMBEDDING_API_KEY=
TEI_EMBEDDING_TIMEOUT_SECONDS=30
TEI_EMBEDDING_BATCH_SIZE=16
RAG_TOP_K=8
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# Optional isolated-worker execution. Leave local unless all required worker
# settings and cluster permissions are available.
POC_EXECUTION_BACKEND=local
ISOLATED_JOB_NAMESPACE=
ISOLATED_WORKER_IMAGE=
WORKER_API_BASE_URL=
ISOLATED_WORKER_IMAGE_PULL_POLICY=IfNotPresent
ISOLATED_WORKER_IMAGE_PULL_SECRET_NAMES=
ISOLATED_JOB_TTL_SECONDS_AFTER_FINISHED=300
ISOLATED_JOB_BACKOFF_LIMIT=0
ISOLATED_WORKER_SERVICE_ACCOUNT_NAME=
ISOLATED_WORKER_PLATFORM_LLM_API_KEY_SECRET_NAME=
ISOLATED_WORKER_PLATFORM_LLM_API_KEY_SECRET_KEY=
ISOLATED_WORKER_ENV_ALLOWLIST=
WORKER_API_TOKEN_SECRET=

RUN_RETENTION_CLEANUP_ENABLED=true
RUN_RETENTION_DAYS=7
RUN_RETENTION_CLEANUP_INTERVAL_SECONDS=3600
